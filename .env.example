# Defina a chave nas configurações seguras do ambiente, nunca neste ficheiro.
# O programa lê variáveis do processo; não carrega ficheiros .env.
FRESHSERVICE_DOMAIN=dnspt.freshservice.com
FRESHSERVICE_WORKSPACE=Tech-Support
# ID do canal autorizado; o token Slack é configurado separadamente como segredo.
SLACK_CHANNEL_ID=
